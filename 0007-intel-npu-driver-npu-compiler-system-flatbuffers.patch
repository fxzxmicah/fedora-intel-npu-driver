+    message(STATUS "FlatBuffers targets provided by the parent project")
+elseif(ENABLE_SYSTEM_FLATBUFFERS)
+    set(_flatbuffers_targets_before_find)
+    foreach(_target IN ITEMS flatbuffers::flatbuffers_shared flatbuffers::flatbuffers flatbuffers::flatc)
+        if(TARGET "${_target}")
+            list(APPEND _flatbuffers_targets_before_find "${_target}")
+        endif()
+    endforeach()
+
+    find_host_package(Flatbuffers REQUIRED NAMES Flatbuffers FlatBuffers flatbuffers NO_CMAKE_FIND_ROOT_PATH)
+
+    # Imported targets are normally visible only in the directory in which
