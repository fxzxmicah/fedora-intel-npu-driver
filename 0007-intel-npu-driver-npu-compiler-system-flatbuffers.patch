+    # compiler source directories added later can use the same package.
+    foreach(_target IN ITEMS flatbuffers::flatbuffers_shared flatbuffers::flatbuffers flatbuffers::flatc)
+        if(TARGET "${_target}" AND NOT "${_target}" IN_LIST _flatbuffers_targets_before_find)
+            get_target_property(_aliased_target "${_target}" ALIASED_TARGET)
+            if(NOT _aliased_target)
+                get_target_property(_is_imported "${_target}" IMPORTED)
+                if(_is_imported)
+                    set_property(TARGET "${_target}" PROPERTY IMPORTED_GLOBAL TRUE)
+                endif()
+            endif()
+        endif()
+    endforeach()
+
+    if(NOT TARGET flatbuffers)
+        if(TARGET flatbuffers::flatbuffers_shared)
+            add_library(flatbuffers ALIAS flatbuffers::flatbuffers_shared)
+        elseif(TARGET flatbuffers::flatbuffers)
+            add_library(flatbuffers ALIAS flatbuffers::flatbuffers)
+        endif()
+    endif()
+
+    if(NOT TARGET flatc AND TARGET flatbuffers::flatc)
+        add_executable(flatc ALIAS flatbuffers::flatc)
+    endif()
+
+    if(NOT TARGET flatbuffers OR NOT TARGET flatc)
+        message(FATAL_ERROR "Internal error: Failed to detect system flatbuffers targets")
+    endif()
